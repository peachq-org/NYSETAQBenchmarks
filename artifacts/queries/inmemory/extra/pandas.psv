idx|tags|query|parameter
101||trade.assign(minute=lambda df: df["time"].dt.floor("min"), volume=lambda df: df["size"].astype("float64")).groupby(["sym", "minute"], observed=True).agg(open=("price", "first"), high=("price", "max"), low=("price", "min"), close=("price", "last"), volume=("volume", "sum")).reset_index()|
102||trade.assign(pv=lambda df: df["price"].astype("float64") * df["size"].astype("float64"), volume=lambda df: df["size"].astype("float64")).groupby("sym", observed=True).agg(pv=("pv", "sum"), volume=("volume", "sum"), trades=("price", "size"), high=("price", "max"), low=("price", "min")).assign(vwap=lambda df: df["pv"] / df["volume"]).drop(columns="pv").reset_index()|
103||pd.merge_asof(trade[["sym", "time", "price", "size"]].assign(sym=lambda df: df["sym"].astype(str)), quote[["sym", "time", "bid", "ask"]].assign(sym=lambda df: df["sym"].astype(str)), on="time", by="sym").assign(effSpread=lambda df: 2 * (df["price"].astype("float64") - (df["bid"].astype("float64") + df["ask"].astype("float64")) / 2).abs())|
104||pd.concat([trade[["sym", "time", "price"]].assign(sym=lambda df: df["sym"].astype(str), rid=np.arange(len(trade))), quote[["sym", "time", "bid", "ask"]].assign(sym=lambda df: df["sym"].astype(str))], ignore_index=True).sort_values(["sym", "time"], kind="stable").set_index("time").pipe(lambda w: w.assign(maxBid=w.groupby("sym", sort=False)["bid"].rolling("2s", center=True, closed="both").max().to_numpy(), minAsk=w.groupby("sym", sort=False)["ask"].rolling("2s", center=True, closed="both").min().to_numpy())).loc[lambda w: w["rid"].notna()].reset_index().sort_values("rid")[["sym", "time", "price", "maxBid", "minAsk"]]|
105||trade[["sym", "size"]].assign(sym=lambda df: df["sym"].astype(str)).merge(master[["sym", "securityType"]].assign(sym=lambda df: df["sym"].astype(str)), on="sym", how="left").assign(volume=lambda df: df["size"].astype("float64")).groupby("securityType", dropna=False).agg(volume=("volume", "sum"), trades=("size", "size")).reset_index()|
106||trade[(trade["size"] < 100) & trade["price"].between(10, 100)].groupby("ex", observed=True).size().reset_index(name="trades")|
107||trade.assign(sizeRank=lambda df: df.groupby("sym", observed=True)["size"].rank(method="first", ascending=False).astype("int64")).query("sizeRank <= 10")[["sym", "sizeRank", "time", "size", "price"]]|
108||quote.groupby("ex", observed=True)["sym"].nunique().reset_index(name="symCount")|
109||trade.assign(minute=lambda df: df["time"].dt.floor("min")).groupby(["sym", "minute"], observed=True)["price"].last().astype("float64").reset_index(name="close").sort_values(["sym", "minute"]).assign(ret=lambda df: np.log(df["close"] / df.groupby("sym", observed=True)["close"].shift(1))).dropna(subset=["ret"]).groupby("sym", observed=True)["ret"].agg(nret="count", rvol=lambda s: 10000 * s.std(ddof=0)).reset_index()|
