idx|tags|query|parameter
101||SELECT sym, toIntervalNanosecond(intDiv(toInt64(time), 60000000000) * 60000000000) AS minute, argMin(price, rowid) AS open, max(price) AS high, min(price) AS low, argMax(price, rowid) AS close, sum(toFloat64(size)) AS volume FROM {trade} GROUP BY sym, minute|
102||SELECT sym, sum(toFloat64(price) * toFloat64(size)) / sum(toFloat64(size)) AS vwap, sum(toFloat64(size)) AS volume, count() AS trades, max(price) AS high, min(price) AS low FROM {trade} GROUP BY sym|
103||SELECT t.sym, t.time, t.price, t.size, q.bid, q.ask, 2 * abs(toFloat64(t.price) - (toFloat64(q.bid) + toFloat64(q.ask)) / 2) AS effSpread FROM (SELECT sym, time, price, size, rowid FROM {trade}) t ASOF LEFT JOIN (SELECT sym, time, bid, ask FROM {quote} QUALIFY row_number() OVER (PARTITION BY sym, time ORDER BY rowid DESC) = 1) q USING (sym, time) ORDER BY t.rowid SETTINGS join_use_nulls = 1|
104||SELECT sym, time, price, maxBid, minAsk FROM (SELECT sym, time, price, rid, max(bid) OVER w AS maxBid, min(ask) OVER w AS minAsk FROM (SELECT sym, toInt64(time) AS tn, time, price, CAST(NULL, 'Nullable(Float32)') AS bid, CAST(NULL, 'Nullable(Float32)') AS ask, toNullable(rowid) AS rid FROM {trade} UNION ALL SELECT sym, toInt64(time), time, NULL, bid, ask, NULL FROM {quote}) WINDOW w AS (PARTITION BY sym ORDER BY tn RANGE BETWEEN 1000000000 PRECEDING AND 1000000000 FOLLOWING)) WHERE rid IS NOT NULL ORDER BY rid|
105||SELECT m.securityType, sum(toFloat64(t.size)) AS volume, count() AS trades FROM {trade} t LEFT JOIN {master} m ON t.sym = m.sym GROUP BY m.securityType SETTINGS join_use_nulls = 1|
106||SELECT ex, count() AS trades FROM {trade} WHERE size < 100 AND price BETWEEN 10 AND 100 GROUP BY ex|
107||SELECT sym, sizeRank, time, size, price FROM (SELECT sym, time, size, price, row_number() OVER (PARTITION BY sym ORDER BY size DESC, rowid) AS sizeRank FROM {trade}) WHERE sizeRank <= 10|
108||SELECT ex, count(DISTINCT sym) AS symCount FROM {quote} GROUP BY ex|
109||SELECT sym, count() AS nret, 10000 * stddevPop(ret) AS rvol FROM (SELECT sym, log(toFloat64(close) / lagInFrame(toFloat64(close)) OVER (PARTITION BY sym ORDER BY minute ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)) AS ret, row_number() OVER (PARTITION BY sym ORDER BY minute) AS rn FROM (SELECT sym, intDiv(toInt64(time), 60000000000) AS minute, argMax(price, rowid) AS close FROM {trade} GROUP BY sym, minute)) WHERE rn > 1 GROUP BY sym|
