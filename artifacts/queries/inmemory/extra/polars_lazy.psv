idx|tags|query|parameter
101||trade.group_by("sym", pl.duration(minutes=pl.col("time").dt.total_minutes()).alias("minute")).agg(pl.col("price").first().alias("open"), pl.col("price").max().alias("high"), pl.col("price").min().alias("low"), pl.col("price").last().alias("close"), pl.col("size").cast(pl.Float64).sum().alias("volume"))|
102||trade.group_by("sym").agg((pl.col("price").cast(pl.Float64) * pl.col("size").cast(pl.Float64)).sum().truediv(pl.col("size").cast(pl.Float64).sum()).alias("vwap"), pl.col("size").cast(pl.Float64).sum().alias("volume"), pl.len().alias("trades"), pl.col("price").max().alias("high"), pl.col("price").min().alias("low"))|
103||trade.select("sym", "time", "price", "size").join_asof(quote.select("sym", "time", "bid", "ask"), on="time", by="sym").with_columns((2 * (pl.col("price").cast(pl.Float64) - (pl.col("bid").cast(pl.Float64) + pl.col("ask").cast(pl.Float64)) / 2).abs()).alias("effSpread"))|
104||pl.concat([trade.select("sym", "time", "price", pl.int_range(pl.len()).alias("rid")), quote.select("sym", "time", "bid", "ask")], how="diagonal_relaxed").sort("sym", "time").with_columns(pl.col("time").dt.total_nanoseconds().alias("tn")).with_columns(pl.col("bid").max().rolling(index_column="tn", period="2000000000i", offset="-1000000000i", closed="both").over("sym").alias("maxBid"), pl.col("ask").min().rolling(index_column="tn", period="2000000000i", offset="-1000000000i", closed="both").over("sym").alias("minAsk")).filter(pl.col("rid").is_not_null()).sort("rid").select("sym", "time", "price", "maxBid", "minAsk")|
105||trade.join(master.select("sym", "securityType"), on="sym", how="left").group_by("securityType").agg(pl.col("size").cast(pl.Float64).sum().alias("volume"), pl.len().alias("trades"))|
106||trade.filter(pl.col("size") < 100, pl.col("price").is_between(10, 100, closed="both")).group_by("ex").agg(pl.len().alias("trades"))|
107||trade.with_columns(pl.col("size").rank("ordinal", descending=True).over("sym").alias("sizeRank")).filter(pl.col("sizeRank") <= 10).select("sym", "sizeRank", "time", "size", "price")|
108||quote.group_by("ex").agg(pl.col("sym").n_unique().alias("symCount"))|
109||trade.group_by("sym", pl.col("time").dt.total_minutes().alias("minute")).agg(pl.col("price").last().cast(pl.Float64).alias("close")).sort("sym", "minute").with_columns((pl.col("close") / pl.col("close").shift(1).over("sym")).log().alias("ret")).filter(pl.col("ret").is_not_null()).group_by("sym").agg(pl.len().alias("nret"), (10000 * pl.col("ret").std(ddof=0)).alias("rvol"))|
